{
  "schema": "odir.agreement.v1",
  "mode": "template",
  "title": "Photographer engaging — Person to person engagement",
  "notice": "Draft for review — not legal advice. A UK solicitor reviews this template before any real member signs.",
  "base": "P2P",
  "jurisdiction": "NI",
  "jurisdiction_name": "Northern Ireland",
  "consumer": false,
  "roles": {
    "engager": "photographer",
    "provider": null
  },
  "parties": [
    {
      "slot": "engager",
      "label": "the Photographer",
      "role": "photographer",
      "role_label": "Photographer",
      "kind": "person"
    },
    {
      "slot": "provider",
      "label": "the Provider",
      "role": null,
      "role_label": null,
      "kind": "person"
    }
  ],
  "sources": {
    "base": {
      "key": "P2P",
      "version": 1,
      "sha256": "sha256:0403ad2a66d533b1d45dab47fea3a5a460586168890c43d038cacf6a7abca41a"
    },
    "engager_module": {
      "role_key": "photographer",
      "version": 1,
      "sha256": "sha256:28c15920d4687409c98e3444926d8826d56f328ee23889323748157ce746ed2e",
      "stale": false
    },
    "provider_module": null,
    "overrides": {
      "count": 0,
      "sha256": null
    }
  },
  "sections": [
    {
      "key": "cover",
      "title": "Cover",
      "clauses": [
        {
          "id": "p2p.parties.1",
          "category": "parties_authority",
          "text": "This agreement is between the Photographer, who books and pays, and the Provider, who does the work. Both are individuals.",
          "source": "base",
          "replaces": null,
          "locked": true,
          "checkable": false
        },
        {
          "id": "p2p.parties.business",
          "category": "parties_authority",
          "text": "The Photographer books for the purposes of their trade, business or profession, not as a consumer.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "photographer.engager.parties.1",
          "category": "parties_authority",
          "text": "The Photographer books as a working photographer, for a shoot that is part of their business.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": false
        }
      ]
    },
    {
      "key": "duties",
      "title": "Role and duties",
      "clauses": [
        {
          "id": "p2p.duties.1",
          "category": "role_duties",
          "text": "The Provider will carry out {{engagement_summary}} with reasonable care and skill, as this agreement describes.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.duties.2",
          "category": "role_duties",
          "text": "The Photographer will give the Provider the information and access they reasonably need to do the work, in good time.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "photographer.engager.duties.brief",
          "category": "role_duties",
          "text": "The Photographer sends the Provider a brief for the shoot, with reference images where useful, at least {{brief_days}} days before it.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": true
        },
        {
          "id": "photographer.engager.duties.direct",
          "category": "role_duties",
          "text": "The Photographer directs the shoot and has the final say on the look of the images.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": false
        }
      ]
    },
    {
      "key": "place_time",
      "title": "Place and time",
      "clauses": [
        {
          "id": "p2p.place.1",
          "category": "place",
          "text": "The work takes place at {{venue}}, unless both parties agree a change in writing through SnapLink.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.place.2",
          "category": "place",
          "text": "Whoever controls the venue makes sure it is safe to work in and tells the other party about any known hazard before the start.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "photographer.engager.place.1",
          "category": "place",
          "text": "The Photographer confirms the venue, parking and access details to the Provider at least 48 hours before the shoot.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.time.1",
          "category": "time_hours",
          "text": "The work is on {{engagement_date}}, from {{start_time}} to {{finish_time}}.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.time.2",
          "category": "time_hours",
          "text": "Work beyond the agreed hours happens only if both parties agree it at the time, including the rate for it, and that agreement is recorded through SnapLink.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "photographer.engager.time.1",
          "category": "time_hours",
          "text": "The Photographer gives the Provider a call sheet with the times for each part of the shoot.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": false
        }
      ]
    },
    {
      "key": "pay",
      "title": "Pay",
      "clauses": [
        {
          "id": "p2p.pay.1",
          "category": "pay",
          "text": "The Photographer will pay the Provider {{fee}} ({{rate_basis}}).",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.pay.2",
          "category": "pay",
          "text": "A deposit of {{deposit}} is due when both parties have signed. The balance is due within {{payment_days}} days of the work being completed.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.pay.vat",
          "category": "pay",
          "text": "The Provider is {{vat_status}}.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.pay.vat_business",
          "category": "pay",
          "text": "Where the Provider is registered for VAT, VAT is added to the fee at the rate in force when it is invoiced.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "photographer.engager.pay.1",
          "category": "pay",
          "text": "The Photographer pays the Provider whether or not the images are later used or published.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.expenses.1",
          "category": "expenses_equipment",
          "text": "Each party supplies the equipment and materials this agreement gives to them, and looks after their own equipment.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.expenses.2",
          "category": "expenses_equipment",
          "text": "Travel and other expenses are paid only where this agreement, or a later agreement recorded through SnapLink, says so, against receipts.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "photographer.engager.expenses.1",
          "category": "expenses_equipment",
          "text": "The Photographer supplies the lighting, backdrops and space the shoot needs; the Provider brings the tools of their own trade.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": false
        }
      ]
    },
    {
      "key": "terms",
      "title": "Terms",
      "clauses": [
        {
          "id": "p2p.usage.1",
          "category": "usage_licence",
          "text": "Where the work produces material protected by copyright, its creator keeps the copyright. Any licence to use it is set out in this agreement, and any other use needs the creator’s written consent.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "photographer.engager.usage.portfolio",
          "category": "usage_licence",
          "text": "The Provider may use up to {{portfolio_count}} of the final images in their own portfolio once the Photographer has published them, credited as “{{portfolio_credit}}”.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.copyright.1",
          "category": "copyright_moral_rights",
          "text": "Nothing in this agreement assigns copyright unless a clause says so expressly, names what is assigned and states the fee for it. An assignment takes effect only when the creator has signed this agreement.",
          "source": "base",
          "replaces": null,
          "locked": true,
          "checkable": false
        },
        {
          "id": "p2p.copyright.2",
          "category": "copyright_moral_rights",
          "text": "Moral rights cannot be assigned. They are waived only where a clause says so expressly and the creator has signed this agreement.",
          "source": "base",
          "replaces": null,
          "locked": true,
          "checkable": false
        },
        {
          "id": "photographer.engager.copyright.1",
          "category": "copyright_moral_rights",
          "text": "Copyright in the images belongs to the Photographer as the photographer. The Provider keeps any rights they have in their own designs.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.safety.1",
          "category": "safety_licences",
          "text": "Each party follows the health and safety rules that apply at the venue and does not ask the other to do anything unsafe.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.safety.2",
          "category": "safety_licences",
          "text": "The Provider holds any licence, registration or insurance that this agreement says the work needs, and shows it on request.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "photographer.engager.safety.1",
          "category": "safety_licences",
          "text": "The Photographer makes sure the set is safe, including lighting stands, cables and props, and tells the Provider about any hazard on arrival.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.cancel.provider",
          "category": "cancellation_no_show",
          "text": "If the Provider cancels, or does not attend, the Photographer gets back everything paid for the cancelled work within 14 days.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.cancel.noshow",
          "category": "cancellation_no_show",
          "text": "A party who does not attend without telling the other is recorded on SnapLink as a no-show, unless their reason is accepted through SnapLink’s dispute route.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.cancel.business",
          "category": "cancellation_no_show",
          "text": "Either party may cancel by message through SnapLink. If the Photographer cancels less than {{notice_hours}} hours before the start, {{late_cancellation_share}} of the fee is due to the Provider as a fair estimate of their loss.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "photographer.engager.cancel.reschedule",
          "category": "cancellation_no_show",
          "text": "If the Photographer moves the shoot with at least {{notice_hours}} hours’ notice, the booking moves to the new date without a cancellation charge if the Provider is free then.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.conf.1",
          "category": "confidentiality_consent",
          "text": "Each party keeps private any personal details they learn about the other through this booking, and uses them only to carry it out, as UK data protection law requires.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.conf.2",
          "category": "confidentiality_consent",
          "text": "No one is filmed or photographed for publication without their consent.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "photographer.engager.conf.1",
          "category": "confidentiality_consent",
          "text": "The Photographer tells the Provider in advance if the shoot is confidential, for example an unreleased product, and what may not be shared.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": false
        }
      ]
    },
    {
      "key": "proof_disputes",
      "title": "Proof and disputes",
      "clauses": [
        {
          "id": "p2p.proof.1",
          "category": "proof_of_completion",
          "text": "The work counts as done when the Provider has carried out the duties set out in this agreement. Either party may record evidence of this through SnapLink, where it is kept privately and not published.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.proof.accept_business",
          "category": "proof_of_completion",
          "text": "If the Photographer raises no problem within 7 days of the work being completed, the work is treated as accepted.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "photographer.engager.proof.1",
          "category": "proof_of_completion",
          "text": "The Photographer confirms through SnapLink, on the day, that the Provider attended and did the agreed work, or says what was not done.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": true
        },
        {
          "id": "p2p.disputes.1",
          "category": "disputes_record",
          "text": "A disagreement about this agreement goes first to SnapLink’s dispute route, and both parties take part in it in good faith before going elsewhere.",
          "source": "base",
          "replaces": null,
          "locked": false,
          "checkable": false
        },
        {
          "id": "p2p.disputes.law",
          "category": "disputes_record",
          "text": "This agreement is governed by the law of Northern Ireland, and the courts of Northern Ireland may decide any claim about it.",
          "source": "base",
          "replaces": null,
          "locked": true,
          "checkable": false
        },
        {
          "id": "p2p.disputes.record",
          "category": "disputes_record",
          "text": "SnapLink keeps the signed version, the signature records and the terms hash that identifies this exact text. The terms hash may be recorded on a public blockchain; no name, address, pay or other personal detail is recorded there.",
          "source": "base",
          "replaces": null,
          "locked": true,
          "checkable": false
        },
        {
          "id": "photographer.engager.disputes.1",
          "category": "disputes_record",
          "text": "The Photographer tells the Provider about any problem with their work during the shoot where possible, so it can be put right on the day.",
          "source": "engager_module",
          "replaces": null,
          "locked": false,
          "checkable": false
        }
      ]
    },
    {
      "key": "acceptance",
      "title": "Acceptance and seal",
      "clauses": [
        {
          "id": "p2p.accept.age",
          "category": "parties_authority",
          "text": "Each party confirms, when signing, that they are 18 or over. SnapLink keeps this confirmation with their signature record.",
          "source": "base",
          "replaces": null,
          "locked": true,
          "checkable": false
        },
        {
          "id": "p2p.accept.freeze",
          "category": "disputes_record",
          "text": "The terms are fixed when the first party signs. Any change needs a new version signed by both parties; the earlier version is kept unchanged.",
          "source": "base",
          "replaces": null,
          "locked": true,
          "checkable": false
        }
      ]
    }
  ],
  "fields": [
    {
      "key": "engagement_summary",
      "label": "What the work is",
      "category": "role_duties",
      "type": "text",
      "default": null,
      "value": null,
      "source": "base"
    },
    {
      "key": "venue",
      "label": "Venue and address",
      "category": "place",
      "type": "text",
      "default": null,
      "value": null,
      "source": "base"
    },
    {
      "key": "engagement_date",
      "label": "Date",
      "category": "time_hours",
      "type": "date",
      "default": null,
      "value": null,
      "source": "base"
    },
    {
      "key": "start_time",
      "label": "Start time",
      "category": "time_hours",
      "type": "time",
      "default": null,
      "value": null,
      "source": "base"
    },
    {
      "key": "finish_time",
      "label": "Finish time",
      "category": "time_hours",
      "type": "time",
      "default": null,
      "value": null,
      "source": "base"
    },
    {
      "key": "fee",
      "label": "Fee",
      "category": "pay",
      "type": "money",
      "default": null,
      "value": null,
      "source": "base"
    },
    {
      "key": "rate_basis",
      "label": "Rate basis (hourly, day or fixed fee)",
      "category": "pay",
      "type": "text",
      "default": "a fixed fee",
      "value": null,
      "source": "base"
    },
    {
      "key": "deposit",
      "label": "Deposit",
      "category": "pay",
      "type": "money",
      "default": "no deposit",
      "value": null,
      "source": "base"
    },
    {
      "key": "payment_days",
      "label": "Days to pay the balance",
      "category": "pay",
      "type": "number",
      "default": "14",
      "value": null,
      "source": "base"
    },
    {
      "key": "vat_status",
      "label": "Provider’s VAT status and number",
      "category": "pay",
      "type": "text",
      "default": "not registered for VAT",
      "value": null,
      "source": "base"
    },
    {
      "key": "notice_hours",
      "label": "Cancellation notice (hours)",
      "category": "cancellation_no_show",
      "type": "number",
      "default": "48",
      "value": null,
      "source": "base"
    },
    {
      "key": "late_cancellation_share",
      "label": "Share of the fee due on a late cancellation",
      "category": "cancellation_no_show",
      "type": "text",
      "default": "50%",
      "value": null,
      "source": "base"
    },
    {
      "key": "brief_days",
      "label": "Days before the shoot the brief is sent",
      "category": "role_duties",
      "type": "number",
      "default": "2",
      "value": null,
      "source": "engager_module"
    },
    {
      "key": "portfolio_count",
      "label": "Images the provider may use in their portfolio",
      "category": "usage_licence",
      "type": "number",
      "default": "10",
      "value": null,
      "source": "engager_module"
    },
    {
      "key": "portfolio_credit",
      "label": "Portfolio credit line",
      "category": "usage_licence",
      "type": "text",
      "default": null,
      "value": null,
      "source": "engager_module"
    }
  ],
  "style": {
    "paper": "waxed-parchment",
