{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odir-inspector-snapshot/1",
  "title": "ODIR Brain Inspector snapshot of SnapLink's role registry",
  "description": "Written by brain/src/inspector.js (a plain script, no LLM) from the read-only text of base44/shared/taxonomy/registry.js. registry_sha256 is what brain/QUEUE.md pins; snapshot_sha256 covers every other field. Both are sha256 of the adapter's canonical JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "taxonomy_revision", "families", "sectors", "roles", "role_count", "registry_sha256", "snapshot_sha256"],
  "properties": {
    "schema": { "const": "odir-inspector-snapshot/1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_id", "ref", "path", "file_sha256"],
      "properties": {
        "app_id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
        "ref": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "const": "base44/shared/taxonomy/registry.js" },
        "file_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "taxonomy_revision": { "type": "integer", "minimum": 1 },
    "families": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z_]{1,31}$" } },
    "sectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": { "key": { "$ref": "#/$defs/key" }, "label": { "type": "string", "minLength": 1, "maxLength": 120 } }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "family", "sectors"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "family": { "type": "string", "pattern": "^[A-Z][A-Z_]{1,31}$" },
          "sectors": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/key" } }
        }
      }
    },
    "role_count": { "type": "integer", "minimum": 1 },
    "registry_sha256": { "$ref": "#/$defs/sha256" },
    "snapshot_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,59}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
